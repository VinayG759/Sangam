# ─────────────────────────────────────────────────────────────────────────────
# Sangam — Root Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# This file is used by docker-compose.yml and any root-level scripts.
# Copy to .env and fill in the values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini ───────────────────────────────────────────────────────────
# Get your free API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Supabase (production deployment) ───────────────────────────────────────
# Only needed if deploying to Supabase instead of local Docker Postgres
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# DATABASE_URL=

# ── Messaging Channels (optional) ──────────────────────────────────────────
# Telegram bot for citizen voice ingestion
# TELEGRAM_BOT_TOKEN=

# Meta WhatsApp Cloud API for WhatsApp voice note ingestion
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# ── Security ────────────────────────────────────────────────────────────────
# Server-side pepper for hashing channel user IDs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# USER_HASH_PEPPER=

# ── Deployment ──────────────────────────────────────────────────────────────
# Set in GitHub Actions secrets for keepalive workflow
# SANGAM_API_URL=https://your-backend.onrender.com
