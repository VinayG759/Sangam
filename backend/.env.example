# ─────────────────────────────────────────────────────────────────────────────
# Sangam Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# For Docker Compose, set DATABASE_URL host to "db" instead of "localhost".
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────────────────
# Environment mode: "development" | "production"
ENV=development

# Project name (used in logging and metadata)
PROJECT_NAME=Sangam

# ── Database ────────────────────────────────────────────────────────────────
# Supabase/PostgreSQL connection string (with PostGIS + pgvector extensions)
#
# Local:    postgresql://postgres:postgres@localhost:5432/sangam
# Docker:   postgresql://postgres:postgres@db:5432/sangam
# Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sangam

# Async database URL (auto-derived from DATABASE_URL if not set)
# Only set this if you need a different async driver or pooler endpoint
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sangam

# ── Google Gemini AI ────────────────────────────────────────────────────────
# Get your free API key from Google AI Studio:
#   https://aistudio.google.com/apikey
#
# Required for: citizen report analysis, semantic embeddings, policy brief generation
# Without it: the app runs but Gemini calls return safe fallback values
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for text generation (structured output)
# gemini-3.6-flash 503s under free-tier load; gemini-2.5-flash and
# text-embedding-004 (below) no longer exist. See app/config.py for details.
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini model for semantic embeddings (768 dimensions, forced via
# output_dimensionality since gemini-embedding-001 defaults to 3072)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Country Packs ───────────────────────────────────────────────────────────
# PACKS_DIR is left unset here on purpose. app/config.py's default resolves an
# absolute path to <repo root>/packs, which works no matter what directory the
# process is started from. Only set this if you need to point at packs living
# somewhere else entirely (e.g. PACKS_DIR=/workspace/packs inside Docker).
# PACKS_DIR=/absolute/path/to/packs

# Which country pack to activate
# Available: india_karnataka, default
ACTIVE_COUNTRY_PACK=india_karnataka

# ── Citizen Channels ────────────────────────────────────────────────────────
# Telegram bot token from @BotFather. Required for the Telegram intake
# webhook (app/routes/webhooks.py); without it, incoming updates are logged
# and dropped.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Twilio Sandbox credentials. Required for the WhatsApp intake webhook.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# HMAC pepper used to hash channel user IDs (Telegram chat ID, WhatsApp
# number) before they touch the database -- this is what lets a citizen
# reporter's identity stay unrecoverable from a stolen DB. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, app/utils/hashing.py falls back to a fixed value baked into the
# source and logs a warning -- fine for local dev, not for a real deployment.
REPORTER_HASH_PEPPER=your_random_pepper_here
