# Sangam backend settings. Copy to backend/.env for local development.
# In production, set these in the host's environment (e.g. Render → Environment).

# Postgres with the pgvector extension (Supabase provides it).
#   Local:    postgresql://postgres:postgres@localhost:5432/sangam_v2
#   Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sangam_v2

# Which folder under packs/ this deployment serves.
ACTIVE_COUNTRY_PACK=india

# Browser origins allowed to call the API, comma-separated (your Vercel URL in production).
ALLOWED_ORIGINS=http://localhost:5173

# Admin endpoints (start analysis, reprocess, flagged reports) require
#   Authorization: Bearer <ADMIN_TOKEN>
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# HMAC key for hashing reporter IDs. Generate once and never change it:
#   python -c "import secrets; print(secrets.token_hex(32))"
REPORTER_HASH_PEPPER=

# Google Gemini (AI Studio key). Without it, reports are stored and processed later.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Telegram: bot token from @BotFather, and a secret you choose. Register the webhook with
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=<API>/api/v1/webhooks/telegram&secret_token=<SECRET>
# Updates without the secret are rejected.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp (Meta Cloud API).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Meta-approved message template for status updates (WhatsApp only allows free text within 24h of the
# citizen's last message). Body must take {{1}} = tracking ID and {{2}} = the update. Empty = no WhatsApp updates.
WHATSAPP_NOTIFY_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Status updates to citizens. Their chat ID is stored ENCRYPTED with this key, used once to tell them their
# report reached the priority list, then deleted (or after 180 days). Empty = nothing is stored, no updates.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTACT_ENCRYPTION_KEY=
# Public dashboard address, used for tracking links in those updates.
PUBLIC_APP_URL=http://localhost:5173

# Set true once to load ~4,700 synthetic demo reports on start-up (replaces earlier synthetic ones).
SEED_DEMO=false

# Kill switches — set false to turn a feature off without code changes.
FEATURE_TELEGRAM=true
FEATURE_WHATSAPP=true
FEATURE_WEB_INTAKE=true
FEATURE_SIMULATOR=true
FEATURE_EXPORT=true
FEATURE_IMPACT=true
FEATURE_NOTIFY=true
