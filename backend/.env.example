# ─────────────────────────────────────────────────────────────────────────────
# Sangam Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# For Docker Compose, set DATABASE_URL host to "db" instead of "localhost".
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────────────────
# Environment mode: "development" | "production"
ENV=development

# Project name (used in logging and metadata)
PROJECT_NAME=Sangam

# ── Database ────────────────────────────────────────────────────────────────
# Supabase/PostgreSQL connection string (with PostGIS + pgvector extensions)
#
# Local:    postgresql://postgres:postgres@localhost:5432/sangam
# Docker:   postgresql://postgres:postgres@db:5432/sangam
# Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sangam

# Async database URL (auto-derived from DATABASE_URL if not set)
# Only set this if you need a different async driver or pooler endpoint
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sangam

# ── Google Gemini AI ────────────────────────────────────────────────────────
# Get your free API key from Google AI Studio:
#   https://aistudio.google.com/apikey
#
# Required for: citizen report analysis, semantic embeddings, policy brief generation
# Without it: the app runs but Gemini calls return safe fallback values
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for text generation (structured output)
GEMINI_MODEL=gemini-2.5-flash

# Gemini model for semantic embeddings (768 dimensions)
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── Country Packs ───────────────────────────────────────────────────────────
# Directory containing pack configurations (relative to backend working dir)
PACKS_DIR=packs

# Which country pack to activate
# Available: india_karnataka, default
ACTIVE_COUNTRY_PACK=india_karnataka
